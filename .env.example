# .env.example

# Barclays IBAN
BARCLAYS_IBAN=

# Citibank Wire details
CITIBANK_WIRE_ACCOUNT_NUMBER=
CITIBANK_WIRE_ROUTING_NUMBER=
CITIBANK_WIRE_SWIFT_CODE=

# JazzCash, EasyPaisa, Raast Instant ID
JAZZCASH_MERCHANT_ID=
EASYPAY_MERCHANT_ID=
RAAST_INSTANT_ID=

# ADMIN_OFFICE_PASSCODE (Default: "NexaVault2026Secret!")
ADMIN_OFFICE_PASSCODE=NexaVault2026Secret!

# CRON_SECRET
CRON_SECRET=

# Cloudflare R2 Keys
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_REGION=

# Multi-AI API Keys
MULTI_AI_API_KEY_1=
MULTI_AI_API_KEY_2=
MULTI_AI_API_KEY_3=

# Vercel Cron scheduled job configuration
VERCEL_CRON_SCHEDULE=0 0 * * *

# Database connection URL
DATABASE_URL=

# Prisma schema path
PRISMA_SCHEMA_PATH=prisma/schema.prisma

# Next.js environment variables
NEXT_PUBLIC_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STATIC_URL=

# Other environment variables
NODE_ENV=
PORT=