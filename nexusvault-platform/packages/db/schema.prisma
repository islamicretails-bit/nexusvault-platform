datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String?
  role     Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  products  Product[]
  reviews   Review[]
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  stock       Int
  vendor      User     @relation(fields: [vendorId], references: [id])
  vendorId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]
  reviews    Review[]
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  total      Float
  status     OrderStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELED
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  shopName String
  shopDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}

model Affiliate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  affiliateId String
  commission  Float
  createdAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Translation {
  id        String   @id @default(cuid())
  language String
  text     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIModel {
  id          String   @id @default(cuid())
  name        String
  description String?
  modelType   AIModelType
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum AIModelType {
  TRANSLATION
  SENTIMENT_ANALYSIS
  RECOMMENDATION
}

model CustomerExperience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  experience  String
  rating      Int
  createdAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}